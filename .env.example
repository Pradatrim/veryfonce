# ─────────────────────────────────────────────────────────────
# FONCÉ environment variables
# Copy this file to ".env" and fill in real values.
# The app RUNS without any of these (in demo mode) so you can
# develop locally. Fill them in when you go live.
# ─────────────────────────────────────────────────────────────

# Database (Postgres). Get a free one from Neon (neon.tech), Supabase, or
# Vercel Storage. Paste its connection string here. Example shape:
# DATABASE_URL="postgresql://user:pass@host:5432/fonce?sslmode=require"
DATABASE_URL=""

# Secret used to sign login session cookies. Use any long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# The single owner/admin account (the "VIP" login that sees all money).
# On first run the seed script creates this account.
ADMIN_EMAIL="owner@fonce.app"
ADMIN_PASSWORD="changeme123"

# Platform fee taken by FONCÉ (the owner) on every sale, in percent.
# e.g. "10" = FONCÉ keeps 10% of the creator's markup.
PLATFORM_FEE_PERCENT="10"

# ── Stripe (payments + automatic fee splitting via Stripe Connect) ──
# Leave blank to run in DEMO mode (payments are simulated, no real money).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── AliExpress (product import + automatic order fulfillment) ──
# Leave blank to run in DEMO mode (import uses a parser/mock,
# auto-ordering is simulated and queued instead of really placed).
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""

# ScrapingBee — reliable server-side product import (renders the page through
# premium proxies). Get a key at scrapingbee.com. When auto-detection still
# fails, the creator enters the price once in the dashboard (then it locks).
SCRAPINGBEE_API_KEY=""

# Dev only: set to "1" to generate rich fake product data when an import can't
# be auto-detected (handy for testing the UI). Leave blank in production so
# failed imports go to the manual price-entry flow instead.
IMPORT_DEMO=""

# Base URL of the app (used for links + Stripe redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Profile photo storage ──
# On Vercel, add a Blob store and this token is set automatically. Leave blank
# locally to store uploads on disk (public/uploads).
BLOB_READ_WRITE_TOKEN=""
